# Which provider stores subscribers: "resend" | "convertkit" | "mailchimp" | "none"
# "none" logs to the server console only (handy for local development).
EMAIL_PROVIDER=resend

# Public URL of the guide asset (PDF, Notion page, etc.) emailed to new subscribers
GUIDE_DOWNLOAD_URL=https://example.com/guide.pdf

# ---------- Resend ----------
RESEND_API_KEY=
# Audience to store contacts in (Resend dashboard -> Audiences)
RESEND_AUDIENCE_ID=
# Must be a verified sender domain in Resend
RESEND_FROM_EMAIL="Edge Playbook <guide@yourdomain.com>"

# ---------- ConvertKit (Kit) ----------
# ConvertKit sends the guide itself through the form's incentive email / automation.
CONVERTKIT_API_KEY=
CONVERTKIT_FORM_ID=

# ---------- Mailchimp ----------
# Trigger the guide email with a Mailchimp Customer Journey on "joins audience".
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# Data center prefix, e.g. us21 (the suffix of your API key)
MAILCHIMP_SERVER_PREFIX=
