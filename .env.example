# EXAMPLE ONLY — these values are placeholders and will not connect to any provider.
# Never put real credentials in this file. Use protected environment settings for deployments.

# Server-only Supabase project access (provide either key format).
SUPABASE_URL=https://example.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
# SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key

# Server-side model generation.
OPENAI_API_KEY=sk-replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Resend sender must use a verified sending domain.
RESEND_API_KEY=re_replace-with-your-resend-api-key
RESEND_FROM_EMAIL=Matt Wayne <newsletter@example.com>

# OAuth and application access controls.
# Use exact HTTPS origins for deployed environments; http://localhost:3000 is for local development only.
APP_ORIGINS=http://localhost:3000,https://your-preview-origin.example,https://your-production-domain.example
ADMIN_EMAILS=admin@example.com

# Replace with a random value of at least 32 characters.
NEWSLETTER_UNSUBSCRIBE_SECRET=replace-with-a-random-secret-at-least-32-characters
